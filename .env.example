# Configuration MongoDB
MONGO_URI=mongodb://localhost:27017/medicsearch
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=medicsearch

# Configuration Neo4j
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=votre_mot_de_passe_ici
NEO4J_DATABASE=medicament
NEO4J_ID=a7aa048e-2334-45b7-ac75-999e6158c2be

# Configuration Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ── Mistral AI ───────────────────────────────────────────────────────
# Alimente l'assistant conversationnel, la recherche IA et l'aide a la
# prescription. Sans elle, ces trois fonctions restent silencieuses (pas
# d'erreur visible, juste aucune reponse) -- le reste de l'application
# fonctionne normalement.
#
# A generer sur https://console.mistral.ai/api-keys/ -- une cle propre a
# chaque personne/deploiement, jamais recopiee d'un .env recu par ailleurs
# (une ancienne cle de ce projet a fini publiee sur GitHub par ce biais,
# voir config.py).
MISTRAL_API_KEY=

# ── Securite ─────────────────────────────────────────────────────────
# Cle de signature de la session, qui porte l identite de l utilisateur
# connecte. Sans elle l application refuse de demarrer : une cle connue
# permettrait de forger une session d administrateur.
#
# En generer une, propre a chaque deploiement :
#     python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# A mettre a 1 des que le site est servi en HTTPS : le cookie de session
# ne partira alors plus en clair.
SESSION_COOKIE_SECURE=0
